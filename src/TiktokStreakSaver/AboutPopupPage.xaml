<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
             x:Class="TiktokStreakSaver.AboutPopupPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="24" RowSpacing="24">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" HorizontalOptions="Center" Margin="0, 16, 0, 0">
            <Label x:Name="HeaderTitle"
                   Text="{svc:Tr About_Welcome}"
                   Style="{StaticResource PageTitleLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Label x:Name="VersionLabel" 
                   Text="v1.0.0" 
                   Style="{StaticResource DataLabel}" 
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Label x:Name="SubHeaderLabel" 
                   Text="{svc:Tr About_Tagline}" 
                   Style="{StaticResource DataLabel}" 
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Scrollable content area -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24">
                
                <Border Style="{StaticResource SectionCard}" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeThickness="0"
                        Padding="0"
                        x:Name="ChangelogBorder">
                    <WebView x:Name="ChangelogWebView"
                             HeightRequest="300"
                             BackgroundColor="Transparent"
                             VerticalOptions="FillAndExpand"/>
                </Border>

                <!-- App Information -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{svc:Tr About_ThisApp}" Style="{StaticResource SectionLabel}"/>
                    <Label Text="{svc:Tr About_Description}" 
                           Style="{StaticResource ValueLabel}" 
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <!-- Project & author -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="{svc:Tr About_OpenSource}" Style="{StaticResource SectionLabel}" Margin="0, 0, 0, 4"/>
                    <Label Text="{svc:Tr About_ByOriginalAuthor}" Style="{StaticResource ValueLabel}"/>
                    <Label Text="https://github.com/Jon2G/TiktokStreakSaver"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           FontSize="12" />
                </VerticalStackLayout>

                <!--
                    Continuation credit. The original creator and the upstream author keep their credit
                    above and below; this line only records who carries the project on.
                -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="{svc:Tr About_ContinuedBy}" Style="{StaticResource ValueLabel}"/>
                    <Label Text="{svc:Tr About_ContinuedBody}"
                           Style="{StaticResource DataLabel}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{svc:Tr About_Credits}" Style="{StaticResource SectionLabel}" Margin="0, 8, 0, 4"/>
                    <Label Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{svc:Tr About_PortCredit}" />
                                <Span Text="eulfn"
                                      TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                      TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFeenerCreditTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text="{svc:Tr About_PortCreditTail}" />
                                <Span Text="streak-tiktok"
                                      TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                      TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFeenerCreditTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text="{svc:Tr About_FeenerTail}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{svc:Tr About_CreditedSpecifically}"
                           Style="{StaticResource DataLabel}"
                           Margin="0, 6, 0, 0"/>
                    <Label Style="{StaticResource DataLabel}" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{svc:Tr About_Feature1}&#10;" />
                                <Span Text="{svc:Tr About_Feature2}&#10;" />
                                <Span Text="{svc:Tr About_Feature3}&#10;" />
                                <Span Text="{svc:Tr About_Feature4}&#10;" />
                                <Span Text="{svc:Tr About_Feature5}&#10;" />
                                <Span Text="{svc:Tr About_Feature6}&#10;" />
                                <Span Text="{svc:Tr About_Feature7}&#10;" />
                                <Span Text="{svc:Tr About_Feature8}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Data & Permissions Notice -->
                <VerticalStackLayout Spacing="8" Margin="0, 0, 0, 12">
                    <Label Text="{svc:Tr About_Privacy}" 
                           Style="{StaticResource SectionLabel}" 
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" 
                           FontSize="12"/>
                    <Label Text="{svc:Tr About_LocalOnly}" 
                           Style="{StaticResource DataLabel}" 
                           LineBreakMode="WordWrap" 
                           FontSize="12"/>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Footer -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <!-- Download progress — hidden unless download is active -->
            <Label x:Name="ProgressLabel"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   FontSize="13"/>

            <!-- Update buttons: Install + Later (shown only for update popups) -->
            <Grid x:Name="UpdateButtonGrid"
                  ColumnDefinitions="*, 12, *"
                  IsVisible="False">
                <Button x:Name="LaterButton"
                        Grid.Column="0"
                        Text="{svc:Tr About_Later}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                        CornerRadius="12"
                        HeightRequest="56"
                        Clicked="OnLaterClicked"/>
                <Button x:Name="InstallButton"
                        Grid.Column="2"
                        Text="{svc:Tr About_Install}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                        FontFamily="InterSemiBold"
                        CornerRadius="12"
                        HeightRequest="56"
                        Clicked="OnInstallClicked"/>
            </Grid>

            <!-- Continue button: shown only for onboarding (non-update) popups -->
            <Button x:Name="CloseButton"
                    Text="{svc:Tr About_Continue}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="12"
                    HeightRequest="56"
                    Clicked="OnCloseClicked"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
