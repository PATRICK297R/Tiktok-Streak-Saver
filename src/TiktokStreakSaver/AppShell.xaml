<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TiktokStreakSaver.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
    xmlns:pages="clr-namespace:TiktokStreakSaver.Pages"
    Title="{svc:Tr App_Name}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <TabBar>
        <ShellContent
            Title="{svc:Tr Title_Dashboard}"
            ContentTemplate="{DataTemplate pages:DashboardPage}"
            Route="DashboardPage"
            Shell.TabBarIsVisible="False" />

        <ShellContent
            Title="{svc:Tr Nav_History}"
            ContentTemplate="{DataTemplate pages:HistoryPage}"
            Route="HistoryPage"
            Shell.TabBarIsVisible="False" />

        <ShellContent
            Title="{svc:Tr Nav_Friends}"
            ContentTemplate="{DataTemplate pages:FriendsPage}"
            Route="FriendsPage"
            Shell.TabBarIsVisible="False" />

        <ShellContent
            Title="{svc:Tr Prof_Title}"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage"
            Shell.TabBarIsVisible="False" />
    </TabBar>

</Shell>
