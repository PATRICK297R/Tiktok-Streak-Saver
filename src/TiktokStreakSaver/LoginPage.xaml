<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
             x:Class="TiktokStreakSaver.LoginPage"
             Title="{svc:Tr Prof_LoginToTikTok}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="Transparent"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="20">
            <VerticalStackLayout Spacing="4">
                <Label Text="{svc:Tr Prof_LoginToTikTok}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}"
                       FontFamily="InterSemiBold"
                       FontSize="20"/>
                <Label Text="{svc:Tr Login_Body}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                       FontSize="13"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Border>

        <WebView x:Name="TikTokWebView"
                 Grid.Row="1"
                 Navigating="OnWebViewNavigating"
                 Navigated="OnWebViewNavigated"/>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="1"
              IsVisible="True"
              BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                   HeightRequest="48"
                                   WidthRequest="48"/>
                <Label Text="{svc:Tr Login_Loading}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}"
                       FontSize="13"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource BottomActionBorder}">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Text="{svc:Tr Pv_Back}"
                        Style="{StaticResource TextButton}"
                        HeightRequest="44"
                        Clicked="OnBackClicked"/>
                <Button Grid.Column="1"
                        Text="{svc:Tr Login_Refresh}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                        FontFamily="InterSemiBold"
                        CornerRadius="14"
                        HeightRequest="44"
                        Clicked="OnRefreshClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
