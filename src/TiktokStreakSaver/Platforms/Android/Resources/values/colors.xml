<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Splash background, light / default system theme: black, with the white flame on top.

    Deliberately not the brand red any more. A full-screen red flash at every launch is loud, and on a
    phone used in a dark room it is the brightest thing the user sees all day. Black is quiet, and the
    white flame still reads instantly as this app.
  -->
  <color name="maui_splash_color">#000000</color>

  <!-- Android 12+ themed splash background (used by App.StartingTheme / values-v31). Matches above. -->
  <color name="splash_bg">#000000</color>
</resources>
