<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Splash background, light / default system theme.

    Brand red in both themes on purpose. The splash used to be red below Android 12 and white from 12
    onwards, so the same app opened two different ways depending on the phone - and the Android 12 one
    put a red flame on that white, leaving the brand colour out of the launch entirely.
  -->
  <color name="maui_splash_color">#FE2C55</color>

  <!-- Android 12+ themed splash background (used by App.StartingTheme / values-v31). Matches above. -->
  <color name="splash_bg">#FE2C55</color>
</resources>
