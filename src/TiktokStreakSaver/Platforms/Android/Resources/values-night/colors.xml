<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Splash background, dark mode: black, same as the light theme.

    The splash is a brand moment rather than a page, so it does not follow the phone's theme - one launch
    screen everywhere, which is also what stops the app from opening differently depending on a setting
    the user did not connect to the app at all.
  -->
  <color name="maui_splash_color">#000000</color>

  <!-- Adaptive launcher icon background in dark mode (pairs with @mipmap-night-anydpi-v26/appicon*.xml) -->
  <color name="appicon_adaptive_background">#121212</color>

  <!-- Android 12+ themed splash background (dark). Matches above, and the light theme. -->
  <color name="splash_bg">#000000</color>
</resources>
