<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
             xmlns:views="clr-namespace:TiktokStreakSaver.Views"
             x:Class="TiktokStreakSaver.Pages.FriendsPage"
             Title="{svc:Tr Nav_Friends}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid>

        <RefreshView x:Name="MainRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="16">

                    <VerticalStackLayout Spacing="2" Margin="0,8,0,0">
                        <Label Text="{svc:Tr Fr_Title}"
                               Style="{StaticResource PageTitleLabel}"
                               HorizontalOptions="Start"/>
                        <Label Text="{svc:Tr Fr_Subtitle}"
                               FontFamily="InterRegular"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Start"/>
                    </VerticalStackLayout>

                    <!-- Login required warning (visible only when no TikTok session) -->
                    <Border x:Name="LoginRequiredBanner"
                            IsVisible="False"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12"
                            Stroke="{AppThemeBinding Light=#FED7AA, Dark=#9A3412}"
                            BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#2A1A0E}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="!"
                                   FontFamily="InterSemiBold"
                                   FontSize="18"
                                   WidthRequest="28" HeightRequest="28"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="{AppThemeBinding Light=#D97706, Dark=#FBBF24}"
                                   TextColor="{AppThemeBinding Light=White, Dark=Black}"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{svc:Tr Fr_LoginRequired}"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#9A3412, Dark=#FBBF24}"/>
                                <Label Text="{svc:Tr Fr_LoginRequiredBody}"
                                       FontFamily="InterRegular"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#7C2D12, Dark={StaticResource Gray300}}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="{svc:Tr Fr_LogIn}"
                                    FontSize="12" Padding="12,0" HeightRequest="36"
                                    CornerRadius="14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                    Clicked="OnLoginRequiredClicked"/>
                        </Grid>
                    </Border>

                    <!-- Battery restrictions warning (visible when automation is on and battery optimizations aren't disabled) -->
                    <Border x:Name="BatteryRestrictionsBanner"
                            IsVisible="False"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12"
                            Stroke="{AppThemeBinding Light=#FEF08A, Dark=#854D0E}"
                            BackgroundColor="{AppThemeBinding Light=#FEFCE8, Dark=#2A220A}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="!"
                                   FontFamily="InterSemiBold"
                                   FontSize="18"
                                   WidthRequest="28" HeightRequest="28"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="{AppThemeBinding Light=#CA8A04, Dark=#FACC15}"
                                   TextColor="{AppThemeBinding Light=White, Dark=Black}"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{svc:Tr Fr_BatteryTitle}"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#854D0E, Dark=#FACC15}"/>
                                <Label Text="{svc:Tr Fr_BatteryBody}"
                                       FontFamily="InterRegular"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#713F12, Dark={StaticResource Gray300}}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="{svc:Tr Fr_Allow}"
                                    FontSize="12" Padding="12,0" HeightRequest="36"
                                    CornerRadius="14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                    Clicked="OnBatteryRestrictionsClicked"/>
                        </Grid>
                    </Border>

                    <!-- Mode Switcher (Friends / Groups). The way into arranging the order sits in each
                         mode's own toolbar, so it is one press away from wherever the user is looking. -->
                    <Border x:Name="ModeSwitcher"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                        <Grid ColumnDefinitions="*,*" HeightRequest="44">
                            <Border x:Name="FriendsModeTabBorder"
                                    Grid.Column="0"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    StrokeShape="RoundRectangle 22">
                                <Label x:Name="FriendsModeTabLabel"
                                       Text="{svc:Tr Nav_Friends}"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFriendsModeTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border x:Name="GroupsModeTabBorder"
                                    Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 22">
                                <Label x:Name="GroupsModeTabLabel"
                                       Text="{svc:Tr Fr_Groups}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGroupsModeTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        Shown while the order is being arranged. The moves are staged: they change the list on
                        screen and are only written when Save is tapped, so backing out leaves the stored
                        order exactly as it was.

                        Kept deliberately quiet. It used to be a pink panel with a pink outline, a pink
                        title and a filled pink button spanning half the width, which made the notice
                        louder than the list it was asking the user to rearrange. The state is already
                        obvious - the rows have turned into draggable cards - so this only has to say
                        what to do and offer the two ways out.
                    -->
                    <Border x:Name="ReorderBanner"
                            IsVisible="False"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12"
                            Stroke="{AppThemeBinding Light={StaticResource ListItemBorderLight}, Dark={StaticResource ListItemBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ListItemLight}, Dark={StaticResource ListItemDark}}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{svc:Tr Fr_ReorderBannerTitle}"
                                       Style="{StaticResource SectionLabel}"/>
                                <Label Text="{svc:Tr Fr_ReorderBannerBody}"
                                       Style="{StaticResource DataLabel}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="{svc:Tr Common_Cancel}"
                                    Style="{StaticResource TextButton}"
                                    VerticalOptions="Center"
                                    Clicked="OnCancelReorderClicked"/>

                            <Button x:Name="SaveOrderButton"
                                    Grid.Column="2"
                                    Text="{svc:Tr Common_Save}"
                                    IsEnabled="False"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                    FontFamily="InterSemiBold"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="40"
                                    Padding="20,0"
                                    VerticalOptions="Center"
                                    Clicked="OnSaveReorderClicked"/>
                        </Grid>
                    </Border>

                    <!--
                        ════ Reorder Mode ════

                        The one list the order is actually arranged in, shown instead of the Friends and
                        Groups sections while the mode is on.

                        Both kinds together, in the sequence they will be messaged. The normal view splits
                        that one saved sequence into two filtered sections, so it cannot show where a group
                        sits relative to a friend - and that relative position is a real part of the send
                        order, not a display detail. Showing the sequence itself is what makes the
                        arrangement visible and lets a drag cross between the two kinds.
                    -->
                    <VerticalStackLayout x:Name="ReorderModeContainer" IsVisible="False" Spacing="12">
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label x:Name="ReorderCountLabel"
                                       Text=""
                                       Style="{StaticResource DataLabel}"
                                       LineBreakMode="WordWrap"/>
                                <VerticalStackLayout x:Name="ReorderListContainer" Spacing="8"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════ Friends Mode ════ -->
                    <VerticalStackLayout x:Name="FriendsModeContainer" IsVisible="True" Spacing="16">
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="12">

                                <!--
                                    The toolbar. A FlexLayout rather than a fixed Grid: Reorder now sits here
                                    with Import, Export, Add and Clear, which is five buttons plus the heading,
                                    and on a narrow phone that does not fit on one line. Wrapping moves the
                                    last button onto a second line instead of squeezing the heading to nothing
                                    or clipping a label.
                                -->
                                <FlexLayout x:Name="ActionButtonsRow"
                                            Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="Start"
                                            AlignItems="Center">
                                    <Label Text="{svc:Tr Fr_Streaks}"
                                           Style="{StaticResource SectionLabel}"
                                           VerticalOptions="Center"
                                           Margin="0,0,12,0"/>
                                    <Button Text="{svc:Tr Fr_Import}"
                                            Style="{StaticResource TextButton}"
                                            Margin="0,0,8,0"
                                            Clicked="OnImportFriendsClicked"/>
                                    <Button Text="{svc:Tr Fr_Export}"
                                            Style="{StaticResource TextButton}"
                                            Margin="0,0,8,0"
                                            Clicked="OnExportFriendsClicked"/>
                                    <Button Text="{svc:Tr Fr_Add}"
                                            Style="{StaticResource TextButton}"
                                            Margin="0,0,8,0"
                                            Clicked="OnAddFriendClicked"/>
                                    <Button Text="{svc:Tr Fr_Clear}"
                                            Style="{StaticResource TextButton}"
                                            TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                                            Margin="0,0,8,0"
                                            Clicked="OnDeleteAllFriendsClicked"/>
                                    <!-- Arranging friends past other friends. Hidden while arranging, because
                                         Save and Cancel in the banner are the only two ways out of it. -->
                                    <Button x:Name="ReorderToggleButton"
                                            Text="{svc:Tr Fr_Reorder}"
                                            Style="{StaticResource TextButton}"
                                            Clicked="OnToggleReorderModeClicked"/>
                                </FlexLayout>

                                <Grid x:Name="SearchAndBulkRow" IsVisible="False"
                                      ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Border Grid.Column="0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Entry x:Name="SearchFriendEntry"
                                               Placeholder="{svc:Tr Fr_SearchFriends}"
                                               Margin="12,0"
                                               VerticalOptions="Center"
                                               ClearButtonVisibility="WhileEditing"
                                               BackgroundColor="Transparent"
                                               TextChanged="OnSearchFriendTextChanged"/>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Text="{svc:Tr Fr_EnableAll}"
                                            Style="{StaticResource TextButton}"
                                            FontSize="12" Padding="8,0" HeightRequest="40"
                                            Clicked="OnEnableAllClicked"/>
                                    <Button Grid.Column="2"
                                            Text="{svc:Tr Fr_DisableAll}"
                                            Style="{StaticResource TextButton}"
                                            FontSize="12" Padding="8,0" HeightRequest="40"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                            Clicked="OnDisableAllClicked"/>
                                </Grid>

                                <VerticalStackLayout x:Name="AddFriendPanel" IsVisible="False" Spacing="8">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Entry x:Name="NewFriendUsernameEntry"
                                               Placeholder="{svc:Tr Fr_UsernameHint}"
                                               Margin="12,4"
                                               BackgroundColor="Transparent"/>
                                    </Border>
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Entry x:Name="NewFriendDisplayNameEntry"
                                               Placeholder="{svc:Tr Fr_DisplayNameHint}"
                                               Margin="12,4"
                                               BackgroundColor="Transparent"/>
                                    </Border>
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Editor x:Name="NewFriendMessageEditor"
                                                Placeholder="{svc:Tr Fr_OwnMessageFriend}"
                                                HeightRequest="72"
                                                Margin="12,8"
                                                BackgroundColor="Transparent"/>
                                    </Border>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Text="{svc:Tr Common_Cancel}"
                                                Style="{StaticResource TextButton}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                CornerRadius="14" HeightRequest="40"
                                                Clicked="OnCancelAddFriend"/>
                                        <Button Grid.Column="1"
                                                Text="{svc:Tr Common_Save}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                CornerRadius="14" HeightRequest="40"
                                                Clicked="OnSaveFriend"/>
                                    </Grid>
                                </VerticalStackLayout>

                                <!--
                                    Reading the friend list straight out of the TikTok inbox.

                                    This began as a pink-tinted card with a filled pink button, which
                                    turned out to be too loud: it competed with the friend list it sits
                                    above, and it spent the same saturated accent the rows use for their
                                    own state. The emphasis now comes from the wording - a title and a
                                    one-line explanation - rather than from colour, and the surface is
                                    the same neutral one the rows use.

                                    It is deliberately still its own row rather than one more link in the
                                    toolbar above: that toolbar holds Import, Export, Add and Clear, which
                                    all look alike at a glance, and a first-time user has no way to know
                                    that one of them spares them typing every username by hand.
                                -->
                                <Border x:Name="ImportChatsCard"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="16,14"
                                        Stroke="{AppThemeBinding Light={StaticResource ListItemBorderLight}, Dark={StaticResource ListItemBorderDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource ListItemLight}, Dark={StaticResource ListItemDark}}">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{svc:Tr Fr_ImportChatsTitle}"
                                                   Style="{StaticResource SectionLabel}"/>
                                            <Label Text="{svc:Tr Fr_ImportChatsBody}"
                                                   Style="{StaticResource DataLabel}"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>

                                        <!--
                                            Outlined rather than filled: the accent stays in the label, so the
                                            button is clearly actionable without being a solid pink block.
                                        -->
                                        <Button Grid.Column="1"
                                                Text="{svc:Tr Fr_ImportChatsButton}"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                BorderColor="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                                BorderWidth="1"
                                                FontFamily="InterMedium"
                                                FontSize="14"
                                                CornerRadius="12"
                                                HeightRequest="40"
                                                Padding="14,0"
                                                VerticalOptions="Center"
                                                Clicked="OnImportFromChatsClicked"/>
                                    </Grid>
                                </Border>

                                <VerticalStackLayout x:Name="FriendsListContainer" Spacing="8">
                                    <!--
                                        The moment a new user is most stuck. Pointing at both routes, and at the
                                        import card by name, so the fastest one is not the one they never find.
                                    -->
                                    <Label x:Name="NoFriendsLabel"
                                           Text="{svc:Tr Fr_NoFriends}"
                                           Style="{StaticResource DataLabel}"
                                           HorizontalOptions="Center"
                                           LineBreakMode="WordWrap"
                                           IsVisible="True"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════ Groups Mode ════ -->
                    <VerticalStackLayout x:Name="GroupsModeContainer" IsVisible="False" Spacing="16">
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="12">

                                <Grid x:Name="GroupActionButtonsGrid" ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="10">
                                    <Label Text="{svc:Tr Fr_GroupChats}"
                                           Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                                    <Button Grid.Column="1"
                                            Text="{svc:Tr Fr_Add}"
                                            Style="{StaticResource TextButton}"
                                            Clicked="OnAddGroupClicked"/>
                                    <Button Grid.Column="2"
                                            Text="{svc:Tr Fr_Clear}"
                                            Style="{StaticResource TextButton}"
                                            TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                                            Clicked="OnDeleteAllGroupsClicked"/>
                                    <!-- Arranging groups past other groups. A second Reorder button rather than
                                         one shared with the Friends toolbar, because the arrangement only moves an
                                         entry past others of its own kind - so in this mode it moves groups, and
                                         in the Friends mode it moves friends. Hidden while arranging. -->
                                    <Button x:Name="GroupReorderToggleButton"
                                            Grid.Column="3"
                                            Text="{svc:Tr Fr_Reorder}"
                                            Style="{StaticResource TextButton}"
                                            Clicked="OnToggleReorderModeClicked"/>
                                </Grid>

                                <Grid x:Name="GroupBulkRow" IsVisible="False"
                                      ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Border Grid.Column="0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Entry x:Name="SearchGroupEntry"
                                               Placeholder="{svc:Tr Fr_SearchGroups}"
                                               Margin="12,0"
                                               VerticalOptions="Center"
                                               ClearButtonVisibility="WhileEditing"
                                               BackgroundColor="Transparent"
                                               TextChanged="OnSearchGroupTextChanged"/>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Text="{svc:Tr Fr_EnableAll}"
                                            Style="{StaticResource TextButton}"
                                            FontSize="12" Padding="8,0" HeightRequest="40"
                                            Clicked="OnEnableAllGroupsClicked"/>
                                    <Button Grid.Column="2"
                                            Text="{svc:Tr Fr_DisableAll}"
                                            Style="{StaticResource TextButton}"
                                            FontSize="12" Padding="8,0" HeightRequest="40"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                            Clicked="OnDisableAllGroupsClicked"/>
                                </Grid>

                                <VerticalStackLayout x:Name="AddGroupPanel" IsVisible="False" Spacing="8">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Entry x:Name="NewGroupNameEntry"
                                               Placeholder="{svc:Tr Fr_GroupNameHint}"
                                               Margin="12,4"
                                               BackgroundColor="Transparent"/>
                                    </Border>
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Entry x:Name="NewGroupDisplayNameEntry"
                                               Placeholder="{svc:Tr Fr_DisplayNameHint}"
                                               Margin="12,4"
                                               BackgroundColor="Transparent"/>
                                    </Border>
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                        <Editor x:Name="NewGroupMessageEditor"
                                                Placeholder="{svc:Tr Fr_OwnMessageGroup}"
                                                HeightRequest="72"
                                                Margin="12,8"
                                                BackgroundColor="Transparent"/>
                                    </Border>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Text="{svc:Tr Common_Cancel}"
                                                Style="{StaticResource TextButton}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                CornerRadius="14" HeightRequest="40"
                                                Clicked="OnCancelAddGroup"/>
                                        <Button Grid.Column="1"
                                                Text="{svc:Tr Common_Save}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                CornerRadius="14" HeightRequest="40"
                                                Clicked="OnSaveGroup"/>
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="GroupsListContainer" Spacing="8">
                                    <!--
                                        Importing reads the inbox, and a group chat is in the inbox, so the
                                        groups a user is in arrive the same way - which is worth saying here,
                                        where someone looking for them would otherwise only see "Add".
                                    -->
                                    <Label x:Name="NoGroupsLabel"
                                           Text="{svc:Tr Fr_NoGroups}"
                                           Style="{StaticResource DataLabel}"
                                           HorizontalOptions="Center"
                                           LineBreakMode="WordWrap"
                                           IsVisible="True"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border x:Name="FriendsStatsCard" Style="{StaticResource SectionCard}" IsVisible="False">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label x:Name="TotalFriendsLabel" Text="0"
                                       Style="{StaticResource ValueLabel}" HorizontalTextAlignment="Center"/>
                                <Label Text="{svc:Tr Fr_Total}" Style="{StaticResource DataLabel}" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label x:Name="EnabledFriendsLabel" Text="0"
                                       Style="{StaticResource ValueLabel}" HorizontalTextAlignment="Center"/>
                                <Label Text="{svc:Tr Fr_Enabled}" Style="{StaticResource DataLabel}" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label x:Name="SentTodayLabel" Text="0"
                                       Style="{StaticResource ValueLabel}" HorizontalTextAlignment="Center"/>
                                <Label Text="{svc:Tr Fr_SentToday}" Style="{StaticResource DataLabel}" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="100" BackgroundColor="Transparent"/>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <views:FloatingNavBar CurrentTab="Friends" VerticalOptions="End"/>
    </Grid>
</ContentPage>
