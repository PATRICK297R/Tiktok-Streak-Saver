<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
             x:Class="TiktokStreakSaver.Pages.IosLimitationsPage"
             Title="{svc:Tr Prof_WhyIosDifferent}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12"
                    Stroke="{AppThemeBinding Light=#FCD34D, Dark=#92400E}"
                    BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#451A03}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{svc:Tr Ios_Experimental}"
                           FontFamily="InterSemiBold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}" />
                    <Label LineBreakMode="WordWrap"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#78350F, Dark=#FDE68A}"
                           Text="{svc:Tr Ios_CannotMatch}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{svc:Tr Ios_WhatWorks}"
                   Style="{StaticResource SectionLabel}" />
            <Label Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"
                   Text="{svc:Tr Ios_WorksList}" />

            <Label Text="{svc:Tr Ios_WhatDoesNotWork}"
                   Style="{StaticResource SectionLabel}" />
            <Label Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"
                   Text="{svc:Tr Ios_LimitsList}" />

            <Label Text="{svc:Tr Ios_Tips}"
                   Style="{StaticResource SectionLabel}" />
            <Label Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"
                   Text="{svc:Tr Ios_TipBody}" />

            <Label Text="{svc:Tr Ios_AppleDocs}"
                   Style="{StaticResource SectionLabel}" />
            <Label Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"
                   Text="{svc:Tr Ios_AppleRules}" />

            <Button Text="{svc:Tr Ios_AppIntentsOpenApp}"
                    Clicked="OnOpenAppWhenRunDoc"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="14"
                    HeightRequest="44" />
            <Button Text="{svc:Tr Ios_AppIntentsModes}"
                    Clicked="OnSupportedModesDoc"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="14"
                    HeightRequest="44" />
            <Button Text="{svc:Tr Ios_BackgroundTasks}"
                    Clicked="OnBackgroundTasksDoc"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="14"
                    HeightRequest="44" />
            <Button Text="{svc:Tr Ios_WkWebView}"
                    Clicked="OnWkWebViewDoc"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="14"
                    HeightRequest="44" />
            <Button Text="{svc:Tr Ios_ShortcutsGuide}"
                    Clicked="OnShortcutsGuideDoc"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="14"
                    HeightRequest="44" />
            <Button Text="{svc:Tr Ios_FullOnGithub}"
                    Clicked="OnFullDoc"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    FontFamily="InterSemiBold"
                    CornerRadius="14"
                    HeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
