<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TiktokStreakSaver.Pages.ImportContactsPage"
             Title="Import from chats"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto, *">

        <!--
            The heading is deliberately short. Everything under it is the state of the scan, and that is
            what this page is for.
        -->
        <VerticalStackLayout Grid.Row="0" Padding="20,18,20,8" Spacing="3">
            <VerticalStackLayout Spacing="2">
                <Label Text="Import from chats"
                       Style="{StaticResource PageTitleLabel}"
                       HorizontalOptions="Start"/>
                <Label Text="Adds the people you already chat with, in one go. Nothing is sent."
                       FontFamily="InterRegular"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="Start"/>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!--
            The scanning state, which used to be one line of text on an otherwise blank page. There is no
            TikTok page on this screen any more, and that is deliberate: the scan runs in a service against
            its own WebView, so there is nothing here to tap, scroll or interfere with, and nothing a stray
            touch can do to a scan that is half way through the inbox. What is left to show is progress,
            what the scan is doing, and the way out.
        -->
        <Grid x:Name="ScanPanel" Grid.Row="1" RowDefinitions="*,Auto">

            <!-- Scrolls rather than clips, so a large font setting cannot push the buttons off the page. -->
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="20,4,20,8" Spacing="14">

                    <Border Style="{StaticResource SectionCard}">
                        <VerticalStackLayout Spacing="16">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <ActivityIndicator x:Name="ScanActivity"
                                                   IsRunning="True"
                                                   WidthRequest="22"
                                                   HeightRequest="22"
                                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                                                   VerticalOptions="Start"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label x:Name="ScanStatusLabel"
                                           Text="Opening your inbox…"
                                           Style="{StaticResource ValueLabel}"
                                           LineBreakMode="WordWrap"/>
                                    <Label x:Name="ScanDetailLabel"
                                           Text=""
                                           Style="{StaticResource DataLabel}"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- What the scan does, so a long wait is not a blank one. -->
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                    <Label Text="1" Style="{StaticResource DataLabel}" HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Opens your TikTok inbox"
                                           Style="{StaticResource DataLabel}"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                                <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                    <Label Text="2" Style="{StaticResource DataLabel}" HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Opens each chat in turn to read the real name"
                                           Style="{StaticResource DataLabel}"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                                <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                    <Label Text="3" Style="{StaticResource DataLabel}" HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Shows you the list to pick from before anything is saved"
                                           Style="{StaticResource DataLabel}"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Pinned to the bottom, so the way out is always in the same place. -->
            <VerticalStackLayout Grid.Row="1" Padding="20,0,20,20" Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="CloseScanButton"
                            Text="Run in background"
                            Style="{StaticResource TextButton}"
                            Clicked="OnCloseScanClicked"/>
                    <Button x:Name="StopScanButton"
                            Grid.Column="1"
                            Text="Stop"
                            Style="{StaticResource TextButton}"
                            Clicked="OnStopScanClicked"/>
                </Grid>

                <Label Text="You can close the app while this runs — the scan keeps going in the background and tells you when it is done."
                       Style="{StaticResource DataLabel}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView x:Name="ResultsPanel" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="20" Spacing="14"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

                <VerticalStackLayout Spacing="2">
                    <Label x:Name="ResultsSummaryLabel"
                           Text=""
                           Style="{StaticResource ValueLabel}"/>
                    <Label x:Name="ResultsDetailLabel"
                           Text=""
                           Style="{StaticResource DataLabel}"
                           LineBreakMode="WordWrap"/>
                    <!--
                        Shown when the scan stopped before the end of the list. Without it a short list of
                        chats reads as a complete one, and the missing half stays invisible.
                    -->
                    <Label x:Name="ResultsWarningLabel"
                           Text=""
                           IsVisible="False"
                           FontFamily="InterRegular"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <!--
                    Nothing is saved until this list has been seen. The scan is a good guess and not an
                    authority: a group whose chat header carries a profile link reads as a person.
                    Ticking rows and correcting them here is what stops a wrong reading from being saved
                    and failing silently on every run.
                -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                    <Button Text="Select all"
                            Style="{StaticResource TextButton}"
                            Clicked="OnSelectAllClicked"/>
                    <Button Grid.Column="1"
                            Text="Select none"
                            Style="{StaticResource TextButton}"
                            Clicked="OnSelectNoneClicked"/>
                    <Button Grid.Column="2"
                            Text="Scan again"
                            Style="{StaticResource TextButton}"
                            HorizontalOptions="End"
                            Clicked="OnScanAgainClicked"/>
                </Grid>

                <Label x:Name="ResultsBlockedLabel"
                       Text=""
                       IsVisible="False"
                       FontFamily="InterRegular"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                       LineBreakMode="WordWrap"/>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout x:Name="ResultsList" Spacing="6"/>
                </Border>

                <Label Text="Tick the ones to add. Use Edit on a row to change its name, its username, or whether it is a person or a group."
                       Style="{StaticResource DataLabel}"
                       LineBreakMode="WordWrap"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="AddContactsButton"
                            Text="Add"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                            CornerRadius="14"
                            HeightRequest="44"
                            Clicked="OnAddContactsClicked"/>
                    <Button Grid.Column="1"
                            Text="Discard"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                            CornerRadius="14"
                            HeightRequest="44"
                            Clicked="OnCancelClicked"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!--
            Shown whenever the scan produced nothing usable: a failure, an inbox that could not be read, or
            a list where everything was already known. Every one of these used to close the page on an alert,
            which left the user holding a message about something they had to fix - sign in, check the
            connection - with no way to act on it from there. Try again is always offered.
        -->
        <ScrollView x:Name="OutcomePanel" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="20" Spacing="14"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

                <VerticalStackLayout Spacing="4">
                    <Label x:Name="OutcomeTitleLabel"
                           Text=""
                           Style="{StaticResource ValueLabel}"/>
                    <Label x:Name="OutcomeReasonLabel"
                           Text=""
                           Style="{StaticResource DataLabel}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <Button x:Name="RetryScanButton"
                        Text="Try again"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                        CornerRadius="14"
                        HeightRequest="44"
                        Clicked="OnScanAgainClicked"/>

                <!--
                    Shown when the reason is one a sign-in would fix. It opens the sign-in page and comes back
                    here, because the import is what the user was doing.
                -->
                <Button x:Name="SignInButton"
                        Text="Sign in to TikTok"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                        CornerRadius="14"
                        HeightRequest="44"
                        Clicked="OnSignInClicked"/>

                <Button Text="Close"
                        Style="{StaticResource TextButton}"
                        HorizontalOptions="Center"
                        Clicked="OnCancelClicked"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
