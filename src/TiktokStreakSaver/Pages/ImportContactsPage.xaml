<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TiktokStreakSaver.Pages.ImportContactsPage"
             Title="Import from chats"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12" Spacing="10">
            <VerticalStackLayout Spacing="2">
                <Label Text="Reading your inbox"
                       Style="{StaticResource PageTitleLabel}"
                       HorizontalOptions="Start"/>
                <Label Text="The app reads your TikTok conversations and then adds the ones you choose, all at once. It opens each chat in turn to read the real name, so a long list takes a while — you can close the app while it works and it will keep going. Nothing is sent."
                       FontFamily="InterRegular"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <!--
                There is no TikTok page on this screen any more, and that is deliberate. The scan runs in a
                service against its own WebView, so there is nothing here to tap, scroll or interfere with,
                and nothing a stray touch can do to a scan that is half way through the inbox.
            -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <ActivityIndicator x:Name="ScanActivity"
                                   IsRunning="True"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                                   VerticalOptions="Center"/>
                <Label x:Name="ScanStatusLabel"
                       Text="Opening your inbox…"
                       Style="{StaticResource DataLabel}"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="CloseScanButton"
                        Text="Run in background"
                        Style="{StaticResource TextButton}"
                        Clicked="OnCloseScanClicked"/>
                <Button x:Name="StopScanButton"
                        Grid.Column="1"
                        Text="Stop"
                        Style="{StaticResource TextButton}"
                        Clicked="OnStopScanClicked"/>
            </Grid>
        </VerticalStackLayout>

        <ScrollView x:Name="ResultsPanel" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="20" Spacing="14"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

                <VerticalStackLayout Spacing="2">
                    <Label x:Name="ResultsSummaryLabel"
                           Text=""
                           Style="{StaticResource ValueLabel}"/>
                    <Label x:Name="ResultsDetailLabel"
                           Text=""
                           Style="{StaticResource DataLabel}"
                           LineBreakMode="WordWrap"/>
                    <!--
                        Shown when the scan stopped before the end of the list. Without it a short list of
                        chats reads as a complete one, and the missing half stays invisible.
                    -->
                    <Label x:Name="ResultsWarningLabel"
                           Text=""
                           IsVisible="False"
                           FontFamily="InterRegular"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <!--
                    Nothing is saved until this list has been seen. The scan is a good guess and not an
                    authority: a group whose name is one word reads as a person, and a person whose
                    display name is not their handle can read as a group. Ticking rows and correcting
                    them here is what stops a wrong reading from being saved and failing silently on
                    every run.
                -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                    <Button Text="Select all"
                            Style="{StaticResource TextButton}"
                            Clicked="OnSelectAllClicked"/>
                    <Button Grid.Column="1"
                            Text="Select none"
                            Style="{StaticResource TextButton}"
                            Clicked="OnSelectNoneClicked"/>
                    <Button Grid.Column="2"
                            Text="Scan again"
                            Style="{StaticResource TextButton}"
                            HorizontalOptions="End"
                            Clicked="OnScanAgainClicked"/>
                </Grid>

                <Label x:Name="ResultsBlockedLabel"
                       Text=""
                       IsVisible="False"
                       FontFamily="InterRegular"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                       LineBreakMode="WordWrap"/>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout x:Name="ResultsList" Spacing="6"/>
                </Border>

                <Label Text="Tick the ones to add. Use Edit on a row to change its name, its username, or whether it is a person or a group — the scan can read a group as a person, and a group is matched by the name in its chat header, so check those before adding."
                       Style="{StaticResource DataLabel}"
                       LineBreakMode="WordWrap"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="AddContactsButton"
                            Text="Add"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                            CornerRadius="14"
                            HeightRequest="44"
                            Clicked="OnAddContactsClicked"/>
                    <Button Grid.Column="1"
                            Text="Discard"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                            CornerRadius="14"
                            HeightRequest="44"
                            Clicked="OnCancelClicked"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!--
            Shown whenever the scan produced nothing usable: a failure, an inbox that could not be read, or
            a list where everything was already known. Every one of these used to close the page on an alert,
            which left the user holding a message about something they had to fix - sign in, check the
            connection - with no way to act on it from there. Try again is always offered.
        -->
        <ScrollView x:Name="OutcomePanel" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="20" Spacing="14"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

                <VerticalStackLayout Spacing="4">
                    <Label x:Name="OutcomeTitleLabel"
                           Text=""
                           Style="{StaticResource ValueLabel}"/>
                    <Label x:Name="OutcomeReasonLabel"
                           Text=""
                           Style="{StaticResource DataLabel}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <Button x:Name="RetryScanButton"
                        Text="Try again"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                        CornerRadius="14"
                        HeightRequest="44"
                        Clicked="OnScanAgainClicked"/>

                <!--
                    Shown when the reason is one a sign-in would fix. It opens the sign-in page and comes back
                    here, because the import is what the user was doing.
                -->
                <Button x:Name="SignInButton"
                        Text="Sign in to TikTok"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                        CornerRadius="14"
                        HeightRequest="44"
                        Clicked="OnSignInClicked"/>

                <Button Text="Close"
                        Style="{StaticResource TextButton}"
                        HorizontalOptions="Center"
                        Clicked="OnCancelClicked"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
