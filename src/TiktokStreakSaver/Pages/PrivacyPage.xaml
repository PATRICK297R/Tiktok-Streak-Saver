<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
             x:Class="TiktokStreakSaver.Pages.PrivacyPage"
             Title="{svc:Tr Prof_PrivacyPolicy}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="*, Auto">

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <VerticalStackLayout Spacing="2" Margin="0,8,0,0">
                    <Label Text="{svc:Tr Prof_PrivacyPolicy}"
                           Style="{StaticResource PageTitleLabel}"
                           HorizontalOptions="Start"/>
                    <Label Text="{svc:Tr Pv_WhatItDoes}"
                           FontFamily="InterRegular"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Start"/>
                    <Label x:Name="EffectiveDateLabel"
                           Text="{svc:Tr Pv_EffectiveDate}"
                           Style="{StaticResource ControlSubLabel}"
                           Margin="0,4,0,0"/>
                </VerticalStackLayout>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Tldr}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_TldrBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Stored}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_StoredBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{svc:Tr Pv_StoredBullet1}"
                                   Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="{svc:Tr Pv_StoredBullet2}"
                                   Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="{svc:Tr Pv_StoredBullet3}"
                                   Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="{svc:Tr Pv_StoredBullet4}"
                                   Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="{svc:Tr Pv_StoredBullet5}"
                                   Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="{svc:Tr Pv_StoredBullet6}"
                                   Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                        <Label Text="{svc:Tr Pv_Erase}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Network}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_NetworkBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{svc:Tr Pv_NetworkTiktokTitle}"
                                       Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_WhatItDoesBody}"
                                       Style="{StaticResource ValueLabel}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{svc:Tr Pv_NetworkGithubTitle}"
                                       Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_NetworkGithub}"
                                       Style="{StaticResource ValueLabel}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label Text="{svc:Tr Pv_NetworkEnd}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Permissions}" Style="{StaticResource SectionLabel}"/>
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="INTERNET, ACCESS_NETWORK_STATE" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_NetworkTiktok}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC, WAKE_LOCK" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_PermForegroundWhy}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SCHEDULE_EXACT_ALARM, USE_EXACT_ALARM" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_PermAlarmWhy}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="RECEIVE_BOOT_COMPLETED" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_PermBootWhy}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_PermBatteryWhy}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="POST_NOTIFICATIONS" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_PermNotificationsWhy}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="REQUEST_INSTALL_PACKAGES" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Pv_PermInstallWhy}"
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label Text="{svc:Tr Pv_PermEnd}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_MinimumAge}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_MinimumAgeBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_ThirdParties}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_ThirdPartiesBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Security}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_SecurityBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Changes}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_ChangesBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Tr Pv_Contact}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{svc:Tr Pv_ContactBody}"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                        <Button x:Name="ContactGitHubButton"
                                Text="{svc:Tr Pv_OpenIssues}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Clicked="OnContactGitHubClicked"/>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="32" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource BottomActionBorder}">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Text="{svc:Tr Pv_Back}"
                        Style="{StaticResource TextButton}"
                        HeightRequest="44"
                        Clicked="OnBackClicked"/>
                <Button Grid.Column="1"
                        Text="{svc:Tr Pv_ViewOnGithub}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                        FontFamily="InterSemiBold"
                        CornerRadius="14"
                        HeightRequest="44"
                        Clicked="OnViewOnGitHubClicked"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
