<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:TiktokStreakSaver.Services"
             xmlns:views="clr-namespace:TiktokStreakSaver.Views"
             x:Class="TiktokStreakSaver.Pages.ProfilePage"
             Title="{svc:Tr Prof_Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <VerticalStackLayout Spacing="2" Margin="0,8,0,0">
                    <Label Text="{svc:Tr Prof_Title}"
                           Style="{StaticResource PageTitleLabel}"
                           HorizontalOptions="Start"/>
                    <Label Text="{svc:Tr Prof_Subtitle}"
                           FontFamily="InterRegular"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{svc:Tr Prof_TikTokAccount}" Style="{StaticResource SectionLabel}"/>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Border WidthRequest="56" HeightRequest="56"
                                    StrokeThickness="2"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}"
                                    StrokeShape="RoundRectangle 28"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                                    VerticalOptions="Center">
                                <Grid>
                                    <Image x:Name="ProfilePhoto"
                                           IsVisible="False"
                                           Aspect="AspectFill"
                                           WidthRequest="56" HeightRequest="56"/>
                                    <Label x:Name="ProfileEmoji"
                                           Text="🎵"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProfilePhotoTapped"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                    <Entry x:Name="DisplayNameEntry"
                                           Placeholder="{svc:Tr Prof_DisplayName}"
                                           Margin="12,4"
                                           BackgroundColor="Transparent"
                                           Completed="OnDisplayNameChanged"
                                           Unfocused="OnDisplayNameChanged"/>
                                </Border>
                                <Label x:Name="DisplayNameHint"
                                       Text="{svc:Tr Prof_PhotoNote}"
                                       Style="{StaticResource DataLabel}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                            <Border x:Name="SessionDot"
                                    WidthRequest="10" HeightRequest="10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="{StaticResource Gray400}"
                                    VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="SessionStatusLabel"
                                       Text="{svc:Tr Prof_Checking}"
                                       Style="{StaticResource ValueLabel}"/>
                                <Label x:Name="SessionLastCheckLabel"
                                       Text=""
                                       Style="{StaticResource DataLabel}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid>
                            <Button x:Name="LoginButton"
                                    Text="{svc:Tr Prof_LoginToTikTok}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                    FontFamily="InterSemiBold"
                                    CornerRadius="14"
                                    HeightRequest="48"
                                    Clicked="OnLoginClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{svc:Tr Prof_Settings}" Style="{StaticResource SectionLabel}"/>

                        <!-- iOS: Shortcuts-only scheduling (no in-app alarms) -->
                        <VerticalStackLayout x:Name="IosShortcutsSettingsPanel"
                                             IsVisible="False"
                                             Spacing="12">
                            <Border StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,12"
                                    Stroke="{AppThemeBinding Light=#FCD34D, Dark=#92400E}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#451A03}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{svc:Tr Prof_IosExperimental}"
                                           FontFamily="InterSemiBold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}"/>
                                    <Label Text="{svc:Tr Prof_IosExperimentalBody}"
                                           FontFamily="InterRegular"
                                           FontSize="13"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#78350F, Dark=#FDE68A}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Button x:Name="IosLimitationsButton"
                                    Text="{svc:Tr Prof_WhyIosDifferent}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="InterSemiBold"
                                    CornerRadius="14"
                                    HeightRequest="44"
                                    Clicked="OnIosLimitationsClicked"/>
                            <Border StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,12"
                                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A5F}"
                                    BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#0F1A2E}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{svc:Tr Prof_SchedulingOnIphone}"
                                           FontFamily="InterSemiBold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#1E40AF, Dark=#93C5FD}"/>
                                    <Label Text="{svc:Tr Prof_IosTimerBody}"
                                           FontFamily="InterRegular"
                                           FontSize="13"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#1E3A8A, Dark={StaticResource Gray300}}"/>
                                    <Label Text="{svc:Tr Prof_IosShortcutHowTo}"
                                           FontFamily="InterRegular"
                                           FontSize="13"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#1E3A8A, Dark={StaticResource Gray300}}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Button x:Name="ShortcutTutorialButton"
                                    Text="{svc:Tr Prof_ShortcutGuide}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="InterSemiBold"
                                    CornerRadius="14"
                                    HeightRequest="44"
                                    Clicked="OnShortcutTutorialClicked"/>
                        </VerticalStackLayout>

                        <!-- Shared run settings (iOS + Android) -->
                        <VerticalStackLayout x:Name="SharedRunSettingsPanel" Spacing="16">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                    <Label Text="{svc:Tr Prof_SkipUnreachable}" Style="{StaticResource ControlTitleLabel}"/>
                                    <Label Text="{svc:Tr Prof_SkipUnreachableBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <Switch x:Name="SkipUnreachableSwitch"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Toggled="OnSkipUnreachableToggled"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                    <Label Text="{svc:Tr Prof_Randomize}" Style="{StaticResource ControlTitleLabel}"/>
                                    <Label Text="{svc:Tr Prof_RandomizeBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <Switch x:Name="RandomizeMessagesSwitch"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Toggled="OnRandomizeMessagesToggled"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Android: in-app background scheduling -->
                        <VerticalStackLayout x:Name="AndroidSchedulingPanel" Spacing="16">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label x:Name="ScheduleTitleLabel" Text="{svc:Tr Prof_BackgroundAutomation}" Style="{StaticResource ControlTitleLabel}"/>
                                <Label x:Name="ScheduleSubtitleLabel" Text="{svc:Tr Prof_BackgroundAutomationBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch x:Name="ScheduleSwitch"
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Toggled="OnScheduleToggled"/>
                        </Grid>

                        <!-- Daily Schedule (visible when automation is ON) -->
                        <VerticalStackLayout x:Name="ScheduleOptionsPanel" IsVisible="False" Spacing="12">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                    <Label Text="{svc:Tr Prof_DailySchedule}" Style="{StaticResource ControlTitleLabel}"/>
                                    <Label Text="{svc:Tr Prof_DailyScheduleBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <Switch x:Name="FixedTimeSwitch"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Toggled="OnFixedTimeToggled"/>
                            </Grid>

                            <VerticalStackLayout x:Name="TimePickerRow" IsVisible="False" Spacing="10">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <Label Text="{svc:Tr Prof_RunAt}" VerticalOptions="Center"
                                           Style="{StaticResource ControlTitleLabel}"/>
                                    <TimePicker x:Name="ScheduleTimePicker"
                                                Grid.Column="1"
                                                Format="HH:mm"
                                                VerticalOptions="Center"
                                                PropertyChanged="OnTimePickerChanged"/>
                                </Grid>

                                <!-- Extra run times. Each row has its own picker, so editing one entry
                                     cannot be confused with choosing a new one to add. -->
                                <VerticalStackLayout x:Name="ScheduleTimesList" Spacing="6"/>

                                <Button x:Name="AddScheduleTimeButton"
                                        Text="{svc:Tr Prof_AddAnotherTime}"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        FontFamily="InterSemiBold"
                                        FontSize="13"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        Padding="14,0"
                                        Clicked="OnAddScheduleTimeClicked"/>

                                <Label x:Name="ScheduleTimesHint"
                                       Text="{svc:Tr Prof_ScheduleTimesHint}"
                                       Style="{StaticResource DataLabel}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Interval (hours-only) — used when Daily Schedule is OFF -->
                        <VerticalStackLayout x:Name="IntervalPanel" Spacing="8">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                    <Label Text="{svc:Tr Prof_RunInterval}" Style="{StaticResource ControlTitleLabel}"/>
                                    <Label x:Name="IntervalSummaryLabel"
                                           Text="{svc:Tr Prof_IntervalSummaryFixed}"
                                           Style="{StaticResource DataLabel}"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <Label x:Name="IntervalHoursValueLabel"
                                       Grid.Column="1"
                                       Text="23"
                                       VerticalOptions="Center"
                                       FontFamily="InterSemiBold"
                                       FontSize="16"
                                       MinimumWidthRequest="32"
                                       HorizontalTextAlignment="Center"/>
                                <Stepper x:Name="IntervalHoursStepper"
                                         Grid.Column="2"
                                         Minimum="1"
                                         Maximum="23"
                                         Increment="1"
                                         Value="23"
                                         VerticalOptions="Center"
                                         ValueChanged="OnIntervalHoursChanged"/>
                            </Grid>
                        </VerticalStackLayout>

                        <Grid x:Name="BatteryLowRow" ColumnDefinitions="*, Auto" ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="{svc:Tr Prof_BatteryLow}" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Prof_BatteryLowBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch x:Name="SendOnBatteryLowSwitch"
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Toggled="OnSendOnBatteryLowToggled"/>
                        </Grid>

                        <Grid x:Name="StreakRiskRow" ColumnDefinitions="*, Auto" ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="{svc:Tr Prof_StreakRisk}" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Prof_StreakRiskBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch x:Name="StreakRiskSwitch"
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Toggled="OnStreakRiskToggled"/>
                        </Grid>

                        <Grid x:Name="StreakRiskTimeRow" ColumnDefinitions="*, Auto" ColumnSpacing="16" IsVisible="False">
                            <Label Text="{svc:Tr Prof_WarnMeAfter}" VerticalOptions="Center"
                                   Style="{StaticResource ControlTitleLabel}"/>
                            <TimePicker x:Name="StreakRiskTimePicker"
                                        Grid.Column="1"
                                        Format="HH:mm"
                                        VerticalOptions="Center"
                                        PropertyChanged="OnStreakRiskTimeChanged"/>
                        </Grid>

                        <Grid x:Name="DryRunRow" ColumnDefinitions="*, Auto" ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="{svc:Tr Prof_DryRun}" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Prof_DryRunBody}" Style="{StaticResource DataLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch x:Name="DryRunSwitch"
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Toggled="OnDryRunToggled"/>
                        </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{svc:Tr Prof_About}" Style="{StaticResource SectionLabel}"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{svc:Tr App_Name}" Style="{StaticResource ValueLabel}"/>
                                <Label x:Name="VersionLabel"
                                       Text="v1.0.0"
                                       Style="{StaticResource DataLabel}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="{svc:Tr Prof_ViewDetails}"
                                    Style="{StaticResource TextButton}"
                                    Clicked="OnAboutClicked"/>
                        </Grid>
                        <Label x:Name="AltStoreUpdatesLabel"
                               Text="{svc:Tr Prof_AltStoreUpdates}"
                               Style="{StaticResource DataLabel}"
                               IsVisible="False"
                               LineBreakMode="WordWrap"/>
                        <Button x:Name="CheckUpdatesButton"
                                Text="{svc:Tr Prof_CheckUpdates}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Clicked="OnCheckUpdatesClicked"/>
                        <Button x:Name="PrivacyPolicyButton"
                                Text="{svc:Tr Prof_PrivacyPolicy}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Clicked="OnPrivacyPolicyClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!--
                    Backup & Restore. Uninstalling deletes the app's private storage, so the only
                    thing that reliably outlives a reinstall is a file the user owns - which also
                    moves to a new phone, something no manifest setting can do.
                -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{svc:Tr Prof_BackupRestore}" Style="{StaticResource SectionLabel}"/>
                            <Label Text="{svc:Tr Prof_BackupBody}"
                                   Style="{StaticResource DataLabel}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="{svc:Tr Prof_BackUp}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                    CornerRadius="14"
                                    HeightRequest="44"
                                    Clicked="OnBackupClicked"/>
                            <Button Grid.Column="1"
                                    Text="{svc:Tr Prof_Restore}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                    CornerRadius="14"
                                    HeightRequest="44"
                                    Clicked="OnRestoreClicked"/>
                        </Grid>

                        <!-- Result of the last backup or restore, so the outcome is never guessed at. -->
                        <Label x:Name="BackupResultLabel"
                               Text=""
                               Style="{StaticResource DataLabel}"
                               LineBreakMode="WordWrap"
                               IsVisible="False"/>
                    </VerticalStackLayout>
                </Border>

                <!--
                    Language. A plain picker rather than the segmented control the Friends page uses: this
                    is a settings row, and two options do not need a custom control. English stays the
                    default, so an existing install shows no change until the user asks for one.
                -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{svc:Tr Prof_Language}" Style="{StaticResource SectionLabel}"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="{svc:Tr Prof_LanguageRow}" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="{svc:Tr Prof_LanguageBody}"
                                       Style="{StaticResource DataLabel}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Picker x:Name="LanguagePicker"
                                    Grid.Column="1"
                                    WidthRequest="150"
                                    VerticalOptions="Center"
                                    SelectedIndexChanged="OnLanguageChanged"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{svc:Tr Prof_Data}" Style="{StaticResource SectionLabel}"/>

                        <!-- Wipes everything this app stored except the TikTok session, so a run can be
                             started again from an empty list without having to sign in again. -->
                        <Button Text="{svc:Tr Prof_ResetData}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Clicked="OnResetDataClicked"/>

                        <Label Text="{svc:Tr Prof_ResetDataNote}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"/>

                        <Button Text="{svc:Tr Prof_Logout}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                TextColor="{AppThemeBinding Light={StaticResource DeleteColor}, Dark={StaticResource DeleteColor}}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Clicked="OnLogoutClicked"/>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="100" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <views:FloatingNavBar CurrentTab="Profile" VerticalOptions="End"/>
    </Grid>
</ContentPage>
